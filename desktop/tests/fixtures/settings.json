{
  "schemaVersion": 1,
  "content": {
    "downloadFolder": "/downloads",
    "lastOptions": {
      "format": {
        "mode": "video",
        "maxHeight": null,
        "audioFormat": "mp3",
        "audioQuality": "0",
        "container": "mp4",
        "containerMethod": "remux",
        "codec": "any",
        "allowHDR": true,
        "exactFormat": ""
      },
      "playlist": {
        "noPlaylist": false,
        "range": "",
        "reverse": false,
        "latestCount": 0,
        "useArchive": false
      },
      "subtitles": {
        "enabled": false,
        "includeAutoGenerated": true,
        "languages": "en.*",
        "embed": true,
        "convertToSRT": false
      },
      "extras": {
        "writeThumbnail": false,
        "embedThumbnail": true,
        "embedMetadata": true,
        "embedChapters": true,
        "splitChapters": false,
        "sponsorBlock": "off",
        "sponsorCategories": [
          "sponsor",
          "selfpromo",
          "interaction"
        ],
        "sectionStart": "",
        "sectionEnd": "",
        "chapterRegex": "",
        "forceKeyframes": false,
        "liveFromStart": false,
        "waitForVideo": false,
        "waitInterval": 60,
        "writeDescription": false,
        "writeComments": false,
        "writeInfoJSON": false
      },
      "network": {
        "cookieBrowser": "none",
        "cookieProfile": "",
        "cookiesFile": "",
        "proxy": "",
        "rateLimit": "",
        "retries": 10,
        "concurrentFragments": 1,
        "useAria2c": false,
        "impersonate": "",
        "xff": "",
        "userAgent": ""
      },
      "output": {
        "template": "%(title)s.%(ext)s",
        "restrictFilenames": false,
        "overwrite": "skipExisting"
      },
      "extraArguments": "",
      "ignoreConfig": true
    },
    "maxConcurrent": 3,
    "notifications": true,
    "clipboardAutofill": true,
    "showTrayIcon": true,
    "autoUpdateYtdlp": true,
    "ytdlpChannel": "stable",
    "didShowWelcome": true,
    "settingsTab": "general",
    "lastAppUpdateCheck": null,
    "latestAppVersion": null,
    "latestAppPage": null,
    "dismissedAppVersion": null
  }
}
